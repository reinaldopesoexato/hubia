FROM python:3.13-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium-headless-shell fonts-liberation fonts-dejavu-core \
    && apt-get clean \
    && pip install --no-cache-dir playwright==1.64.0
COPY bridge/avihub_pdf.py bridge/avihub_pdf_renderer.py /app/bridge/
USER 65534:65534
EXPOSE 8080
CMD ["python", "-m", "bridge.avihub_pdf_renderer"]
